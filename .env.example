# Copy to .env and fill in. Only OPENROUTER_API_KEY is required to run an audit.

# --- Required to run the audit pipeline ---
# OpenRouter API key — used for all model calls AND the LLM judge/classifier.
OPENROUTER_API_KEY=sk-or-v1-...

# --- LLM judge configuration (optional) ---
# The model that classifies each response into a verdict. MUST be held out of the
# benchmark subject pool to avoid a self-preference confound (it is excluded from
# the leaderboard automatically). Defaults to openai/gpt-4o-mini.
JUDGE_MODEL=openai/gpt-4o-mini

# --- Storage / persistence (optional; needed for blob-backed features) ---
# Vercel Blob read/write token — human annotations, grades, and dataset uploads.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Base URL for the public blob bucket used by the analysis scripts.
BLOB_BASE_URL=https://oeqbf51ent3zxva1.public.blob.vercel-storage.com

# SQLite (default) or Postgres connection string for the local result store.
DATABASE_URL=sqlite:///audit.db

# --- HuggingFace dataset sync (optional) ---
HF_TOKEN=hf_...
HF_REPO_ID=jmk9494/moderation-bias-benchmark

# --- Background jobs (optional advanced pipeline) ---
REDIS_URL=redis://localhost:6379/0
