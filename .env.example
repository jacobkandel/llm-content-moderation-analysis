##
## LLM Content Moderation Analysis — Environment Variables
## Copy this file to .env and fill in your values.
## Never commit .env to version control.
##

# ─── Required ─────────────────────────────────────────────────────────────────

# OpenRouter API key — used for all LLM calls (audit, judge, classifier)
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── Optional: Vercel Deployment ──────────────────────────────────────────────

# Needed only if you deploy the web dashboard to Vercel via CI.
# Find these in your Vercel project settings.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ─── Optional: App Config ─────────────────────────────────────────────────────

# Log verbosity: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO

# Runtime environment (affects logging and error handling)
ENVIRONMENT=development

# SQLite database path for caching audit results (default: audit.db)
DB_PATH=audit.db

# ─── Optional: Blob Storage ───────────────────────────────────────────────────

# Vercel Blob token — used by the web dashboard for file storage.
# Required only for the Next.js frontend if using Vercel Blob.
BLOB_READ_WRITE_TOKEN=
